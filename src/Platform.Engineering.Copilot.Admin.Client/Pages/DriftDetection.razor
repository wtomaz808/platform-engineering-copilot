@page "/drift"
@inject EnvironmentApiService EnvironmentApi
@inject DriftApiService DriftApi
@inject IToastService ToastService

<PageTitle>Drift Detection</PageTitle>

@* ===== Azure Policy Drift (Real Data) ===== *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <h4><i class="fa fa-exchange-alt me-2"></i>Drift Detection</h4>
    <button class="btn btn-primary" @onclick="ScanAzureDrift" disabled="@_azureScanning">
        @if (_azureScanning)
        {
            <span class="spinner-border spinner-border-sm me-1"></span>
            <span>Scanning Azure...</span>
        }
        else
        {
            <i class="fa fa-search me-1"></i>
            <span>Scan Azure Drift</span>
        }
    </button>
</div>

@if (_azureLoading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading Azure drift data...</span>
        </div>
    </div>
}
else if (_azureDrift != null && _azureDrift.Status == "not_configured")
{
    <div class="alert alert-info mb-4">
        <i class="fa fa-info-circle me-2"></i>
        @_azureDrift.Message
    </div>
}
else if (_azureDrift != null && _azureDrift.Status == "auth_error")
{
    <div class="alert alert-warning mb-4">
        <i class="fa fa-exclamation-triangle me-2"></i>
        @_azureDrift.Message
    </div>
}
else if (_azureDrift != null && _azureDrift.Status == "ok")
{
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h2 class="text-success">@_azureDrift.CompliantResources</h2>
                    <small class="text-muted">Compliant</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h2 class="text-warning">@_azureDrift.DriftedResources</h2>
                    <small class="text-muted">With Drift</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h2 class="text-info">@_azureDrift.TotalResources</h2>
                    <small class="text-muted">Total Resources</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h2 class="text-muted">@_azureDrift.ScannedAt.ToString("HH:mm")</h2>
                    <small class="text-muted">Last Scan</small>
                </div>
            </div>
        </div>
    </div>

    @if (_azureDrift.DriftItems.Count == 0)
    {
        <div class="alert alert-success mb-4">
            <i class="fa fa-check-circle me-2"></i>
            No configuration drift detected. All resources are compliant with policy baselines.
        </div>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-header">
                <i class="fa fa-exclamation-triangle me-2 text-warning"></i>Azure Policy Drift — @_azureDrift.DriftItems.Count item(s)
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Resource</th>
                            <th>Type</th>
                            <th>Resource Group</th>
                            <th>Severity</th>
                            <th>Policy</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _azureDrift.DriftItems)
                        {
                            <tr>
                                <td>
                                    <span title="@item.ResourceId">@item.ResourceName</span>
                                </td>
                                <td><small class="text-muted">@ShortenResourceType(item.ResourceType)</small></td>
                                <td>@item.ResourceGroup</td>
                                <td>
                                    <span class="badge @GetSeverityBadge(item.Severity)">@item.Severity</span>
                                </td>
                                <td>
                                    <span title="@item.PolicyDefinitionId">@(item.PolicyName ?? "—")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@* ===== Provisioned Environment Drift ===== *@
<div class="d-flex justify-content-between align-items-center mb-3 mt-4">
    <h5><i class="fa fa-server me-2"></i>Provisioned Environment Drift</h5>
    <button class="btn btn-outline-primary btn-sm" @onclick="ScanAllForDrift" disabled="@_scanning">
        @if (_scanning)
        {
            <span class="spinner-border spinner-border-sm me-1"></span>
            <span>Scanning...</span>
        }
        else
        {
            <i class="fa fa-search me-1"></i>
            <span>Scan All Environments</span>
        }
    </button>
</div>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading environments...</span>
        </div>
    </div>
}
else if (_environments.Count == 0)
{
    <div class="alert alert-info">
        <i class="fa fa-info-circle me-2"></i>
        No environments found. <a href="environments/create">Provision a new environment</a> to get started.
    </div>
}
else
{
    <div class="card">
        <div class="card-header">
            <i class="fa fa-list me-2"></i>Environment Drift Status
            <span class="badge bg-secondary ms-2">@_environments.Count(e => e.HasDrift) drifted / @_environments.Count total</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Environment</th>
                        <th>Template</th>
                        <th>Status</th>
                        <th>Drift</th>
                        <th>Last Checked</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var env in _environments)
                    {
                        <tr>
                            <td>
                                <a href="environments/@env.Id">@env.Name</a>
                                @if (!string.IsNullOrEmpty(env.DisplayName))
                                {
                                    <br /><small class="text-muted">@env.DisplayName</small>
                                }
                            </td>
                            <td>@env.TemplateName</td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(env.Status)">@env.Status</span>
                            </td>
                            <td>
                                @if (env.HasDrift)
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="fa fa-exclamation-triangle me-1"></i>
                                        @env.DriftCount items
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        <i class="fa fa-check me-1"></i>In Sync
                                    </span>
                                }
                            </td>
                            <td>
                                @{
                                    var result = _driftResults.GetValueOrDefault(env.Id);
                                }
                                @if (result != null)
                                {
                                    <span title="@result.DetectedAt.ToString("g")">
                                        @GetRelativeTime(result.DetectedAt)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">Not scanned</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary" 
                                            @onclick="() => DetectDrift(env.Id, env.Name)"
                                            disabled="@(_scanningEnvironments.Contains(env.Id))">
                                        @if (_scanningEnvironments.Contains(env.Id))
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            <i class="fa fa-search"></i>
                                        }
                                    </button>
                                    @if (env.HasDrift)
                                    {
                                        <button class="btn btn-outline-success" 
                                                @onclick="() => RemediateDrift(env.Id, env.Name)"
                                                title="Remediate Drift">
                                            <i class="fa fa-wrench"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    // Azure drift state
    private bool _azureLoading = true;
    private bool _azureScanning;
    private DriftScanResponse? _azureDrift;

    // Environment drift state
    private bool _loading = true;
    private bool _scanning;
    private List<EnvironmentListItem> _environments = new();
    private HashSet<string> _scanningEnvironments = new();
    private Dictionary<string, DriftDetectionResult> _driftResults = new();

    protected override async Task OnInitializedAsync()
    {
        // Load both Azure drift and environments in parallel
        var azureTask = LoadAzureDrift();
        var envTask = LoadEnvironments();
        await Task.WhenAll(azureTask, envTask);
    }

    private async Task LoadAzureDrift()
    {
        try
        {
            _azureDrift = await DriftApi.ScanForDriftAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load Azure drift data: {ex.Message}");
        }
        finally
        {
            _azureLoading = false;
        }
    }

    private async Task ScanAzureDrift()
    {
        _azureScanning = true;
        StateHasChanged();

        try
        {
            _azureDrift = await DriftApi.ScanForDriftAsync(forceRefresh: true);
            if (_azureDrift?.Status == "ok")
            {
                if (_azureDrift.DriftedResources > 0)
                    ToastService.ShowWarning($"Azure scan: {_azureDrift.DriftedResources} resource(s) with drift");
                else
                    ToastService.ShowSuccess("Azure scan: No drift detected");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Azure drift scan failed: {ex.Message}");
        }
        finally
        {
            _azureScanning = false;
            StateHasChanged();
        }
    }

    private async Task LoadEnvironments()
    {
        try
        {
            _environments = await EnvironmentApi.GetEnvironmentsAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load environments: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DetectDrift(string id, string name)
    {
        _scanningEnvironments.Add(id);
        StateHasChanged();
        
        try
        {
            var result = await EnvironmentApi.DetectDriftAsync(id);
            if (result != null)
            {
                _driftResults[id] = result;
                if (result.HasDrift)
                {
                    ToastService.ShowWarning($"{name}: {result.DriftCount} drift items detected");
                }
                else
                {
                    ToastService.ShowSuccess($"{name}: No drift detected");
                }
                await LoadEnvironments();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to scan {name}: {ex.Message}");
        }
        finally
        {
            _scanningEnvironments.Remove(id);
            StateHasChanged();
        }
    }

    private async Task RemediateDrift(string id, string name)
    {
        try
        {
            var result = await EnvironmentApi.RemediateDriftAsync(id);
            if (result?.Success == true)
            {
                ToastService.ShowSuccess($"{name}: Drift remediated successfully");
                await LoadEnvironments();
            }
            else
            {
                ToastService.ShowError($"Failed to remediate {name}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to remediate {name}: {ex.Message}");
        }
    }

    private async Task ScanAllForDrift()
    {
        _scanning = true;
        StateHasChanged();
        
        try
        {
            var tasks = _environments.Select(e => DetectDrift(e.Id, e.Name));
            await Task.WhenAll(tasks);
            ToastService.ShowSuccess("Drift scan completed for all environments");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Scan failed: {ex.Message}");
        }
        finally
        {
            _scanning = false;
        }
    }

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Running" => "bg-success",
        "Provisioning" => "bg-info",
        "Updating" => "bg-warning text-dark",
        "Failed" => "bg-danger",
        "Stopped" => "bg-secondary",
        _ => "bg-secondary"
    };

    private string GetRelativeTime(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return dt.ToString("MMM d");
    }

    private string GetSeverityBadge(string severity) => severity switch
    {
        "Critical" => "bg-danger",
        "Warning" => "bg-warning text-dark",
        "Info" => "bg-info",
        _ => "bg-secondary"
    };

    private string ShortenResourceType(string resourceType)
    {
        if (string.IsNullOrEmpty(resourceType)) return "";
        // "Microsoft.Compute/virtualMachines" → "virtualMachines"
        var idx = resourceType.LastIndexOf('/');
        return idx >= 0 ? resourceType[(idx + 1)..] : resourceType;
    }
}
