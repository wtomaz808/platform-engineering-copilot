@* This page has been merged into Settings.razor as the Integrations tab. *@
@* Keeping file for reference but removing route to avoid conflicts. *@
@inject AppSettingsService SettingsService
@inject IntegrationsApiService IntegrationsApi
@inject IToastService ToastService

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Integrations</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0">Integration Settings</h4>
        <small class="text-muted">Configure Azure, GitHub, and Azure DevOps connections</small>
    </div>
    <div>
        <button class="btn btn-primary" @onclick="SaveAllSettings" disabled="@_saving">
            @if (_saving)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            <i class="fa fa-save me-1"></i>Save Settings
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_saveMessage))
{
    <div class="alert @(_saveSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
        <i class="fa @(_saveSuccess ? "fa-check-circle" : "fa-exclamation-circle") me-1"></i>
        @_saveMessage
        <button type="button" class="btn-close" @onclick="() => _saveMessage = null"></button>
    </div>
}

<!-- Azure Integration -->
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center py-2 cursor-pointer" @onclick="() => _azureExpanded = !_azureExpanded" style="cursor:pointer">
        <div class="d-flex align-items-center gap-2">
            <span class="badge rounded-pill @(_settings.Integrations.Azure.Enabled ? "bg-success" : "bg-secondary")" style="width:10px;height:10px;padding:0"></span>
            <i class="fa fa-cloud text-primary"></i>
            <strong>Azure</strong>
            @if (_settings.Integrations.Azure.Enabled)
            {
                <span class="badge bg-success bg-opacity-25 text-success">Enabled</span>
            }
        </div>
        <i class="fa @(_azureExpanded ? "fa-chevron-down" : "fa-chevron-right") text-muted"></i>
    </div>
    @if (_azureExpanded)
    {
        <div class="card-body">
            <!-- Enable toggle -->
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="azureEnabled" @bind="_settings.Integrations.Azure.Enabled">
                <label class="form-check-label" for="azureEnabled">Enable Azure integration</label>
            </div>

            <!-- Cloud Environment -->
            <div class="mb-3">
                <label class="form-label">Cloud Environment</label>
                <select class="form-select" @bind="_settings.Integrations.Azure.CloudEnvironment">
                    <option value="AzureGovernment">Azure Government (US Gov)</option>
                    <option value="AzureCloud">Azure Commercial (Public)</option>
                </select>
            </div>

            <!-- Tenant ID -->
            <div class="mb-3">
                <label class="form-label">
                    Tenant ID
                    <small class="text-muted ms-1">(Entra ID tenant GUID)</small>
                </label>
                <input type="text" class="form-control font-monospace" @bind="_settings.Integrations.Azure.TenantId"
                       placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
            </div>

            <!-- Subscription ID -->
            <div class="mb-3">
                <label class="form-label">
                    Subscription ID
                    <small class="text-muted ms-1">(target Azure subscription)</small>
                </label>
                <input type="text" class="form-control font-monospace" @bind="_settings.Integrations.Azure.SubscriptionId"
                       placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
            </div>

            <!-- Auth Method -->
            <div class="mb-3">
                <label class="form-label">Authentication Method</label>
                <div class="row g-2">
                    <div class="col-md-4">
                        <div class="card h-100 @(_settings.Integrations.Azure.AuthMethod == "credentials" ? "border-primary" : "")"
                             style="cursor:pointer" @onclick='() => SetAzureAuthMethod("credentials")'>
                            <div class="card-body p-2 text-center">
                                <small class="fw-bold @(_settings.Integrations.Azure.AuthMethod == "credentials" ? "text-primary" : "")">Username / Password</small>
                                <br /><small class="text-muted">Your Azure login</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 @(_settings.Integrations.Azure.AuthMethod == "servicePrincipal" ? "border-primary" : "")"
                             style="cursor:pointer" @onclick='() => SetAzureAuthMethod("servicePrincipal")'>
                            <div class="card-body p-2 text-center">
                                <small class="fw-bold @(_settings.Integrations.Azure.AuthMethod == "servicePrincipal" ? "text-primary" : "")">Service Principal</small>
                                <br /><small class="text-muted">App ID + Secret</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 @(_settings.Integrations.Azure.AuthMethod == "managedIdentity" ? "border-primary" : "")"
                             style="cursor:pointer" @onclick='() => SetAzureAuthMethod("managedIdentity")'>
                            <div class="card-body p-2 text-center">
                                <small class="fw-bold @(_settings.Integrations.Azure.AuthMethod == "managedIdentity" ? "text-primary" : "")">Managed Identity</small>
                                <br /><small class="text-muted">Azure-hosted apps</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (_settings.Integrations.Azure.AuthMethod == "credentials")
            {
                <div class="alert alert-info small mb-3">
                    <i class="fa fa-info-circle me-1"></i>
                    Enter your Azure / Entra ID login credentials. The account needs <strong>Contributor</strong> role on the target subscription.
                </div>
                <div class="mb-3">
                    <label class="form-label">
                        Username
                        <small class="text-muted ms-1">(e.g. user@tenant.onmicrosoft.us)</small>
                    </label>
                    <input type="text" class="form-control" @bind="_settings.Integrations.Azure.Username"
                           placeholder="user@yourtenant.onmicrosoft.us" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <div class="input-group">
                        <input type="@(_showAzurePassword ? "text" : "password")" class="form-control" @bind="_settings.Integrations.Azure.Password"
                               placeholder="••••••••••••" />
                        <button class="btn btn-outline-secondary" type="button" @onclick="() => _showAzurePassword = !_showAzurePassword">
                            <i class="fa @(_showAzurePassword ? "fa-eye-slash" : "fa-eye")"></i>
                        </button>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">
                        Client ID
                        <small class="text-muted ms-1">(optional — uses Azure PowerShell default if blank)</small>
                    </label>
                    <input type="text" class="form-control font-monospace" @bind="_settings.Integrations.Azure.ClientId"
                           placeholder="Leave blank to use default" />
                </div>
            }

            @if (_settings.Integrations.Azure.AuthMethod == "servicePrincipal")
            {
                <div class="alert alert-info small mb-3">
                    <i class="fa fa-info-circle me-1"></i>
                    Enter your Service Principal credentials. The SP needs <strong>Contributor</strong> role on the target subscription.
                </div>
                <div class="mb-3">
                    <label class="form-label">
                        Client ID
                        <small class="text-muted ms-1">(Service Principal App ID)</small>
                    </label>
                    <input type="text" class="form-control font-monospace" @bind="_settings.Integrations.Azure.ClientId"
                           placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
                </div>
                <div class="mb-3">
                    <label class="form-label">
                        Client Secret
                        <small class="text-muted ms-1">(Service Principal secret value)</small>
                    </label>
                    <div class="input-group">
                        <input type="@(_showAzureSecret ? "text" : "password")" class="form-control" @bind="_settings.Integrations.Azure.ClientSecret"
                               placeholder="••••••••••••••••••••" />
                        <button class="btn btn-outline-secondary" type="button" @onclick="() => _showAzureSecret = !_showAzureSecret">
                            <i class="fa @(_showAzureSecret ? "fa-eye-slash" : "fa-eye")"></i>
                        </button>
                    </div>
                </div>
            }

            @if (_settings.Integrations.Azure.AuthMethod == "managedIdentity")
            {
                <div class="alert alert-info small mb-3">
                    <i class="fa fa-info-circle me-1"></i>
                    Managed Identity is auto-detected when running in Azure (ACI, AKS, App Service).
                    No credentials needed — just ensure the identity has <strong>Contributor</strong> role on the subscription.
                </div>
            }

            <div class="alert alert-warning small mb-3">
                <i class="fa fa-exclamation-triangle me-1"></i>
                <strong>RBAC:</strong> The identity needs <strong>Contributor</strong> role on the target subscription for list, monitor, deploy, and delete operations.
                Add <strong>User Access Administrator</strong> if RBAC management is also needed.
            </div>

            <!-- Test Connection -->
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="TestAzureConnection"
                        disabled="@(_azureTesting || string.IsNullOrEmpty(_settings.Integrations.Azure.TenantId) || string.IsNullOrEmpty(_settings.Integrations.Azure.SubscriptionId))">
                    @if (_azureTesting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="fa fa-bolt me-1"></i>Test Connection
                </button>
                @if (!string.IsNullOrEmpty(_azureTestMessage))
                {
                    <small class="@(_azureTestSuccess ? "text-success" : "text-danger")">
                        <i class="fa @(_azureTestSuccess ? "fa-check-circle" : "fa-times-circle") me-1"></i>
                        @_azureTestMessage
                    </small>
                }
            </div>
        </div>
    }
</div>

<!-- GitHub Integration -->
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center py-2" style="cursor:pointer" @onclick="() => _githubExpanded = !_githubExpanded">
        <div class="d-flex align-items-center gap-2">
            <span class="badge rounded-pill @(_settings.Integrations.GitHub.Enabled ? "bg-success" : "bg-secondary")" style="width:10px;height:10px;padding:0"></span>
            <i class="fa fa-github text-dark"></i>
            <strong>GitHub</strong>
            @if (_settings.Integrations.GitHub.Enabled)
            {
                <span class="badge bg-success bg-opacity-25 text-success">Enabled</span>
            }
        </div>
        <i class="fa @(_githubExpanded ? "fa-chevron-down" : "fa-chevron-right") text-muted"></i>
    </div>
    @if (_githubExpanded)
    {
        <div class="card-body">
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="githubEnabled" @bind="_settings.Integrations.GitHub.Enabled">
                <label class="form-check-label" for="githubEnabled">Enable GitHub integration</label>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Organization / User
                    <small class="text-muted ms-1">(e.g. azurenoops)</small>
                </label>
                <input type="text" class="form-control" @bind="_settings.Integrations.GitHub.Organization"
                       placeholder="your-org-or-username" />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Personal Access Token
                    <small class="text-muted ms-1">(stored locally only)</small>
                </label>
                <div class="input-group">
                    <input type="@(_showGitHubToken ? "text" : "password")" class="form-control" @bind="_settings.Integrations.GitHub.Token"
                           placeholder="ghp_xxxxxxxxxxxx" />
                    <button class="btn btn-outline-secondary" type="button" @onclick="() => _showGitHubToken = !_showGitHubToken">
                        <i class="fa @(_showGitHubToken ? "fa-eye-slash" : "fa-eye")"></i>
                    </button>
                </div>
                <small class="text-muted">Token is sent to the backend to authenticate GitHub API calls.</small>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    API Base URL
                    <small class="text-muted ms-1">(override for GitHub Enterprise)</small>
                </label>
                <input type="text" class="form-control" @bind="_settings.Integrations.GitHub.ApiBaseUrl"
                       placeholder="https://api.github.com" />
            </div>

            <!-- Test Connection -->
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="TestGitHubConnection"
                        disabled="@(_githubTesting || string.IsNullOrEmpty(_settings.Integrations.GitHub.Token))">
                    @if (_githubTesting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="fa fa-bolt me-1"></i>Test Connection
                </button>
                @if (!string.IsNullOrEmpty(_githubTestMessage))
                {
                    <small class="@(_githubTestSuccess ? "text-success" : "text-danger")">
                        <i class="fa @(_githubTestSuccess ? "fa-check-circle" : "fa-times-circle") me-1"></i>
                        @_githubTestMessage
                    </small>
                }
            </div>
        </div>
    }
</div>

<!-- Azure DevOps Integration -->
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center py-2" style="cursor:pointer" @onclick="() => _adoExpanded = !_adoExpanded">
        <div class="d-flex align-items-center gap-2">
            <span class="badge rounded-pill @(_settings.Integrations.AzureDevOps.Enabled ? "bg-success" : "bg-secondary")" style="width:10px;height:10px;padding:0"></span>
            <i class="fa fa-project-diagram text-info"></i>
            <strong>Azure DevOps</strong>
            @if (_settings.Integrations.AzureDevOps.Enabled)
            {
                <span class="badge bg-success bg-opacity-25 text-success">Enabled</span>
            }
        </div>
        <i class="fa @(_adoExpanded ? "fa-chevron-down" : "fa-chevron-right") text-muted"></i>
    </div>
    @if (_adoExpanded)
    {
        <div class="card-body">
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="adoEnabled" @bind="_settings.Integrations.AzureDevOps.Enabled">
                <label class="form-check-label" for="adoEnabled">Enable Azure DevOps integration</label>
            </div>

            <!-- Server Type -->
            <div class="mb-3">
                <label class="form-label">Server Type</label>
                <div class="row g-2">
                    <div class="col-md-6">
                        <div class="card h-100 @(_settings.Integrations.AzureDevOps.ServerType == "services" ? "border-primary" : "")"
                             style="cursor:pointer" @onclick='() => _settings.Integrations.AzureDevOps.ServerType = "services"'>
                            <div class="card-body p-2">
                                <small class="fw-bold @(_settings.Integrations.AzureDevOps.ServerType == "services" ? "text-primary" : "")">Azure DevOps Services</small>
                                <br /><small class="text-muted">Cloud-hosted (dev.azure.us)</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100 @(_settings.Integrations.AzureDevOps.ServerType == "server" ? "border-primary" : "")"
                             style="cursor:pointer" @onclick='() => _settings.Integrations.AzureDevOps.ServerType = "server"'>
                            <div class="card-body p-2">
                                <small class="fw-bold @(_settings.Integrations.AzureDevOps.ServerType == "server" ? "text-primary" : "")">Azure DevOps Server</small>
                                <br /><small class="text-muted">On-premises / self-hosted</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    @(_settings.Integrations.AzureDevOps.ServerType == "server" ? "Server URL" : "Organization URL")
                    <small class="text-muted ms-1">
                        @(_settings.Integrations.AzureDevOps.ServerType == "server"
                            ? "(e.g. https://your-server:port/tfs)"
                            : "(e.g. https://dev.azure.us/yourorg)")
                    </small>
                </label>
                <input type="text" class="form-control" @bind="_settings.Integrations.AzureDevOps.ServerUrl"
                       placeholder="@(_settings.Integrations.AzureDevOps.ServerType == "server" ? "https://your-server:port/tfs" : "https://dev.azure.us/yourorg")" />
            </div>

            @if (_settings.Integrations.AzureDevOps.ServerType == "server")
            {
                <div class="mb-3">
                    <label class="form-label">
                        Collection
                        <small class="text-muted ms-1">(e.g. DefaultCollection)</small>
                    </label>
                    <input type="text" class="form-control" @bind="_settings.Integrations.AzureDevOps.DefaultCollection"
                           placeholder="DefaultCollection" />
                </div>
            }

            <div class="mb-3">
                <label class="form-label">
                    Personal Access Token
                    <small class="text-muted ms-1">(stored locally only)</small>
                </label>
                <div class="input-group">
                    <input type="@(_showAdoToken ? "text" : "password")" class="form-control" @bind="_settings.Integrations.AzureDevOps.AccessToken"
                           placeholder="ADO personal access token" />
                    <button class="btn btn-outline-secondary" type="button" @onclick="() => _showAdoToken = !_showAdoToken">
                        <i class="fa @(_showAdoToken ? "fa-eye-slash" : "fa-eye")"></i>
                    </button>
                </div>
                <small class="text-muted">Token is sent to the backend to authenticate Azure DevOps API calls.</small>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Project
                    <small class="text-muted ms-1">(optional — leave blank to see all projects)</small>
                </label>
                <input type="text" class="form-control" @bind="_settings.Integrations.AzureDevOps.Project"
                       placeholder="MyProject" />
            </div>

            <!-- Test Connection -->
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="TestAdoConnection"
                        disabled="@(_adoTesting || string.IsNullOrEmpty(_settings.Integrations.AzureDevOps.AccessToken) || string.IsNullOrEmpty(_settings.Integrations.AzureDevOps.ServerUrl))">
                    @if (_adoTesting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="fa fa-bolt me-1"></i>Test Connection
                </button>
                @if (!string.IsNullOrEmpty(_adoTestMessage))
                {
                    <small class="@(_adoTestSuccess ? "text-success" : "text-danger")">
                        <i class="fa @(_adoTestSuccess ? "fa-check-circle" : "fa-times-circle") me-1"></i>
                        @_adoTestMessage
                    </small>
                }
            </div>
        </div>
    }
</div>

@code {
    private AppSettings _settings = new();
    private bool _saving;
    private string? _saveMessage;
    private bool _saveSuccess;

    // Card expansion state
    private bool _azureExpanded = true;
    private bool _githubExpanded;
    private bool _adoExpanded;

    // Password visibility toggles
    private bool _showAzurePassword;
    private bool _showAzureSecret;
    private bool _showGitHubToken;
    private bool _showAdoToken;

    // Azure test connection
    private bool _azureTesting;
    private bool _azureTestSuccess;
    private string? _azureTestMessage;

    // GitHub test connection
    private bool _githubTesting;
    private bool _githubTestSuccess;
    private string? _githubTestMessage;

    // ADO test connection
    private bool _adoTesting;
    private bool _adoTestSuccess;
    private string? _adoTestMessage;

    protected override void OnInitialized()
    {
        // Load current settings (from localStorage via AppSettingsService)
        _settings = CloneSettings(SettingsService.Settings);
    }

    private void SetAzureAuthMethod(string method)
    {
        _settings.Integrations.Azure.AuthMethod = method;
        _settings.Integrations.Azure.UseManagedIdentity = method == "managedIdentity";
    }

    private async Task TestAzureConnection()
    {
        _azureTesting = true;
        _azureTestMessage = null;
        StateHasChanged();

        try
        {
            var result = await IntegrationsApi.TestAzureConnectionAsync(new AzureIntegrationSettings
            {
                Enabled = _settings.Integrations.Azure.Enabled,
                CloudEnvironment = _settings.Integrations.Azure.CloudEnvironment,
                TenantId = _settings.Integrations.Azure.TenantId,
                SubscriptionId = _settings.Integrations.Azure.SubscriptionId,
                AuthMethod = _settings.Integrations.Azure.AuthMethod,
                ClientId = _settings.Integrations.Azure.ClientId,
                ClientSecret = _settings.Integrations.Azure.ClientSecret,
                Username = _settings.Integrations.Azure.Username,
                Password = _settings.Integrations.Azure.Password,
                UseManagedIdentity = _settings.Integrations.Azure.UseManagedIdentity
            });
            _azureTestSuccess = result?.Success ?? false;
            _azureTestMessage = result?.Message ?? "No response.";
        }
        catch (Exception ex)
        {
            _azureTestSuccess = false;
            _azureTestMessage = ex.Message;
        }
        finally
        {
            _azureTesting = false;
        }
    }

    private async Task TestGitHubConnection()
    {
        _githubTesting = true;
        _githubTestMessage = null;
        StateHasChanged();

        try
        {
            var result = await IntegrationsApi.TestGitHubConnectionAsync(new GitHubIntegrationSettings
            {
                Enabled = _settings.Integrations.GitHub.Enabled,
                Organization = _settings.Integrations.GitHub.Organization,
                Token = _settings.Integrations.GitHub.Token,
                ApiBaseUrl = _settings.Integrations.GitHub.ApiBaseUrl
            });
            _githubTestSuccess = result?.Success ?? false;
            _githubTestMessage = result?.Message ?? "No response.";
        }
        catch (Exception ex)
        {
            _githubTestSuccess = false;
            _githubTestMessage = ex.Message;
        }
        finally
        {
            _githubTesting = false;
        }
    }

    private async Task TestAdoConnection()
    {
        _adoTesting = true;
        _adoTestMessage = null;
        StateHasChanged();

        try
        {
            var result = await IntegrationsApi.TestAdoConnectionAsync(new AdoIntegrationSettings
            {
                Enabled = _settings.Integrations.AzureDevOps.Enabled,
                ServerType = _settings.Integrations.AzureDevOps.ServerType,
                ServerUrl = _settings.Integrations.AzureDevOps.ServerUrl,
                AccessToken = _settings.Integrations.AzureDevOps.AccessToken,
                DefaultCollection = _settings.Integrations.AzureDevOps.DefaultCollection,
                Project = _settings.Integrations.AzureDevOps.Project
            });
            _adoTestSuccess = result?.Success ?? false;
            _adoTestMessage = result?.Message ?? "No response.";
        }
        catch (Exception ex)
        {
            _adoTestSuccess = false;
            _adoTestMessage = ex.Message;
        }
        finally
        {
            _adoTesting = false;
        }
    }

    private async Task SaveAllSettings()
    {
        _saving = true;
        _saveMessage = null;
        StateHasChanged();

        try
        {
            // Save to browser localStorage (persists across browser sessions)
            await SettingsService.SaveSettingsAsync(_settings);

            // Also sync to backend API for MCP forwarding
            await IntegrationsApi.SaveIntegrationsAsync(_settings.Integrations);

            _saveSuccess = true;
            _saveMessage = "Integration settings saved successfully.";
            ToastService.ShowSuccess("Integration settings saved.");
        }
        catch (Exception ex)
        {
            _saveSuccess = false;
            _saveMessage = $"Failed to save: {ex.Message}";
            ToastService.ShowError($"Failed to save settings: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private static AppSettings CloneSettings(AppSettings source)
    {
        return new AppSettings
        {
            ApplicationName = source.ApplicationName,
            OrganizationName = source.OrganizationName,
            DefaultCloud = source.DefaultCloud,
            SessionTimeoutMinutes = source.SessionTimeoutMinutes,
            EnableAnalytics = source.EnableAnalytics,
            EnableAutoSave = source.EnableAutoSave,
            NotificationEmail = source.NotificationEmail,
            ToastDurationSeconds = source.ToastDurationSeconds,
            NotifyEnvironmentProvision = source.NotifyEnvironmentProvision,
            NotifyEnvironmentFailure = source.NotifyEnvironmentFailure,
            NotifyDriftDetection = source.NotifyDriftDetection,
            NotifyExpiration = source.NotifyExpiration,
            NotifyCostAnomalies = source.NotifyCostAnomalies,
            NotifyComplianceIssues = source.NotifyComplianceIssues,
            DefaultSubscriptionId = source.DefaultSubscriptionId,
            DefaultLocation = source.DefaultLocation,
            DefaultExpirationDays = source.DefaultExpirationDays,
            DefaultComplianceFramework = source.DefaultComplianceFramework,
            DefaultTags = source.DefaultTags,
            DefaultAutoDelete = source.DefaultAutoDelete,
            Theme = source.Theme,
            ItemsPerPage = source.ItemsPerPage,
            DateFormat = source.DateFormat,
            TimeFormat = source.TimeFormat,
            CurrencySymbol = source.CurrencySymbol,
            DashboardRefreshSeconds = source.DashboardRefreshSeconds,
            ShowCostInLists = source.ShowCostInLists,
            CompactView = source.CompactView,
            InfrastructureAgentEnabled = source.InfrastructureAgentEnabled,
            InfrastructureTemperature = source.InfrastructureTemperature,
            ComplianceAgentEnabled = source.ComplianceAgentEnabled,
            ComplianceTemperature = source.ComplianceTemperature,
            EnableAutomatedRemediation = source.EnableAutomatedRemediation,
            CostAgentEnabled = source.CostAgentEnabled,
            CostTemperature = source.CostTemperature,
            CostAnomalyThreshold = source.CostAnomalyThreshold,
            SecurityComplianceFramework = source.SecurityComplianceFramework,
            MinPasswordLength = source.MinPasswordLength,
            RequireMFA = source.RequireMFA,
            EnforceEncryption = source.EnforceEncryption,
            RequirePrivateEndpoints = source.RequirePrivateEndpoints,
